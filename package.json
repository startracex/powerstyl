{
  "name": "powerstyl",
  "description": "A way to style elements in vanilla JavaScript",
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --fix",
    "lint:check": "oxlint"
  },
  "dependencies": {
    "unnestcss": "^1.3.0"
  },
  "devDependencies": {
    "@startracex/dev-config": "^0.7.0",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "rollup": "^4.68.0",
    "rollup-plugin-oxc": "^0.8.0",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.cjs"
    },
    "./package.json": "./package.json",
    "./src/*": "./src/*"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "powerstyl",
    "css",
    "css-in-js",
    "styled"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/startracex/powerstyl.git"
  },
  "author": "startracex",
  "license": "MIT",
  "packageManager": "pnpm@12.16.1"
}
